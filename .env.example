# VoyageAI Environment Configuration

# LLM Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# External APIs (Optional - Graceful Fallbacks Included)
TAVILY_API_KEY=your_tavily_search_api_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# RAG embeddings (OpenAI-compatible embeddings API; no synthetic embeddings are used)
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
# Comma-separated VoyageAI usernames allowed to manage the RAG knowledge base
RAG_ADMIN_USERNAMES=

# Database (PostgreSQL in production, SQLite fallback for local dev)
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/voyageai
DATABASE_URL=sqlite:///./voyageai.db
# Docker Compose PostgreSQL password (replace before deployment; use URL-safe characters)
POSTGRES_PASSWORD=
APP_PORT=8080

# Security & Authentication
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
PROJECT_NAME="VoyageAI"
TAGLINE="Your intelligent team of AI travel agents."
