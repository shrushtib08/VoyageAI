# VoyageAI Environment Configuration

# LLM Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# External APIs (Optional - Graceful Fallbacks Included)
TAVILY_API_KEY=your_tavily_search_api_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Database (PostgreSQL in production, SQLite fallback for local dev)
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/voyageai
DATABASE_URL=sqlite:///./voyageai.db

# Security & Authentication
SECRET_KEY=voyageai_secret_key_super_secure_random_hash_change_in_production_32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Application Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
PROJECT_NAME="VoyageAI"
TAGLINE="Your intelligent team of AI travel agents."
